{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-base.local/schemas/capability-description.schema.json",
  "title": "能力描述（语言无关）",
  "description": "一个业务能力的唯一声明。业务实现可以是任意语言；本文件是接入方的唯一输入。见 docs/design/2026-09-27-capability-description-contract.md",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "name", "description", "parameters", "result", "execution", "declaration"],
  "properties": {
    "apiVersion": { "const": "agent-base/v1" },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$",
      "description": "工具名：进模型可见的工具表，所以用下划线风格、全小写"
    },
    "label": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 10 },
    "promptSnippet": { "type": "string" },

    "parameters": {
      "type": "object",
      "description": "入参的 JSON Schema（语言无关的唯一描述）",
      "required": ["type"],
      "additionalProperties": true
    },
    "result": {
      "type": "object",
      "description": "结果的 JSON Schema —— 闸门 4 用它断言'返回形状没变'",
      "required": ["type"],
      "additionalProperties": true
    },

    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "entry"],
      "properties": {
        "kind": {
          "enum": ["process", "module"],
          "description": "process=任何语言，走进程边界；module=JS/TS，进程内直接 import（双通道的'A2'：快的保持快）"
        },
        "entry": { "type": "string", "minLength": 1, "description": "相对本描述文件所在目录" },
        "runtime": {
          "enum": ["node", "python", "shell"],
          "description": "kind=process 必填：用哪个解释器跑 entry"
        },
        "timeoutMs": { "type": "integer", "minimum": 1, "maximum": 600000 },
        "argv": { "type": "array", "items": { "type": "string" }, "description": "可选的额外参数（极少用；优先走 stdin）" }
      }
    },

    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic", "sideEffects", "version"],
      "properties": {
        "deterministic": { "type": "boolean", "description": "同样入参永远同样结果（不随机、不读时钟、不访问网络）" },
        "reproducibility": {
          "type": "string",
          "description": "deterministic=false 时**必填**：说清怎么复现（否则闸门无法断言可复算）"
        },
        "sideEffects": { "enum": ["none", "reads-files", "writes-files", "network"] },
        "version": { "type": "string", "minLength": 1, "description": "规则版本：改权重/阈值就要改它，旧结果才解释得清" }
      }
    },

    "unverified": {
      "type": "object",
      "description": "开放命名空间：基座不解释、原样透传的值（`x-*` 之外的声明请写在这里，不要塞进上面的字段）",
      "additionalProperties": true
    }
  }
}
